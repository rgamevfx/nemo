# Required core gate (clang-tidy 18): correctness and actionable copy/move checks.
# Style and modernization are intentionally outside this gate.
# Do not add NOLINT without a reason beside the finding.
Checks: >
    -*,
    clang-analyzer-core.*,
    clang-analyzer-cplusplus.*,
    clang-analyzer-deadcode.*,
    clang-analyzer-unix.*,
    bugprone-dangling-handle,
    bugprone-incorrect-roundings,
    bugprone-integer-division,
    bugprone-misplaced-widening-cast,
    bugprone-sizeof-expression,
    bugprone-undefined-memory-manipulation,
    bugprone-unused-raii,
    bugprone-use-after-move,
    bugprone-virtual-near-miss,
    performance-for-range-copy,
    performance-move-const-arg,
    performance-unnecessary-copy-initialization

# This file is the sole warning-failure policy; the launcher does not override it.
WarningsAsErrors: '*'
# Match both src/nemo/core and the compiler's src/nemo/../nemo/core include paths.
HeaderFilterRegex: '(^|/)nemo/core/.*'
FormatStyle: file
