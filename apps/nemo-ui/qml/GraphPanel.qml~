                    event.accepted = true;
                }
                Keys.onUpPressed: function (event) {
                    graphSearchList.decrementCurrentIndex();
                    event.accepted = true;
                }
                Keys.onEscapePressed: function (event) {
                    event.accepted = true;
                    graphSearchPopup.close();
                    graphPanel.forceActiveFocus();
                }
