{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "NEMO_BUILD_TESTS": "ON",
                "NEMO_BUILD_CLI": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "NEMO_ENABLE_IPO": "ON" }
        },
        {
            "name": "asan",
            "displayName": "Debug + ASan/UBSan",
            "inherits": "debug",
            "cacheVariables": {
                "NEMO_SANITIZER": "address;undefined",
                "NEMO_WARN_AS_ERROR": "ON"
            }
        },
        {
            "name": "tsan",
            "displayName": "Debug + TSan",
            "inherits": "debug",
            "cacheVariables": { "NEMO_SANITIZER": "thread" }
        },
        {
            "name": "headless",
            "displayName": "Headless core/session/catalog",
            "inherits": "debug",
            "cacheVariables": {
                "NEMO_BUILD_UI": "OFF",
                "NEMO_BUILD_GPU": "OFF",
                "NEMO_BUILD_CLI": "OFF"
            }
        },
        {
            "name": "analysis",
            "displayName": "Focused clang-tidy 18 analysis (core only)",
            "inherits": "headless",
            "cacheVariables": {
                "NEMO_BUILD_TESTS": "OFF",
                "NEMO_BUILD_UI": "OFF",
                "NEMO_BUILD_GPU": "OFF",
                "NEMO_BUILD_CLI": "OFF",
                "NEMO_ENABLE_CLANG_TIDY": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan", "configurePreset": "asan" },
        { "name": "headless", "configurePreset": "headless" },
        { "name": "tsan", "configurePreset": "tsan" },
        {
            "name": "analysis",
            "configurePreset": "analysis",
            "targets": ["nemo_core"],
            "jobs": 2,
            "cleanFirst": true,
            "verbose": true
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 0 }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 0 }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 0 },
            "environment": {
                "LSAN_OPTIONS": "suppressions=${sourceDir}/tests/lsan_suppressions.txt"
            }
        },
        {
            "name": "tsan",
            "configurePreset": "tsan",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 0 }
        },
        {
            "name": "headless",
            "configurePreset": "headless",
            "output": { "outputOnFailure": true },
            "execution": { "jobs": 0 }
        }
    ],
    "workflowPresets": [
        {
            "name": "analysis",
            "displayName": "Configure and clean-build the focused core analysis",
            "steps": [
                { "type": "configure", "name": "analysis" },
                { "type": "build", "name": "analysis" }
            ]
        }
    ]
}
