          "/tmp/nemo43-smoke/busy-40.png",
          "/tmp/nemo43-smoke/busy-41.png",
          "/tmp/nemo43-smoke/busy-42.png",
          "/tmp/nemo43-smoke/busy-43.png",
          "/tmp/nemo43-smoke/busy-44.png",
          "/tmp/nemo43-smoke/busy-45.png",
          "/tmp/nemo43-smoke/busy-46.png",
          "/tmp/nemo43-smoke/busy-47.png"
        ],
        "root",
        0
      ]
    },
    {
      "kind": "capture",
      "name": "media-pending"
    },
    {
      "kind": "click",
      "target": {
        "objectName": "mediaSearchField"
      }
    },
    {
      "kind": "key",
      "key": "b"
    },
    {
      "kind": "key",
      "key": "u"
    },
    {
      "kind": "key",
      "key": "s"
    },
    {
      "kind": "key",
      "key": "y"
    },
    {
      "kind": "read",
      "name": "search-during-probe",
      "target": "mediaSearchField",
      "property": "text"
    },
    {
      "kind": "invoke",
      "target": "mediaLibrary",
      "method": "probeState",
      "args": [
        "media-48"
      ]
    },
    {
      "kind": "probe",
      "ticks": 3600,
      "intervalMs": 16
    },
    {
      "kind": "capture",
      "name": "media-busy-progress"
    },
    {
      "kind": "invoke",
      "target": "mediaLibrary",
      "method": "query",
      "args": [
        "project",
        "",
        true,
        {}
      ]
    },
    {
      "kind": "wait",
      "ms": 6000
    },
    {
      "kind": "capture",
      "name": "media-busy-complete"
    },
    {
      "kind": "invoke",
      "target": "mediaLibrary",
      "method": "query",
      "args": [
        "project",
        "",
        true,
        {}
      ]
    },
    {
      "kind": "invoke",
      "target": "projectFile",
      "method": "saveAs",
      "args": [
        "file:///tmp/nemo43-smoke/final-busy-saved.nemo"
      ]
    }
  ]
}
