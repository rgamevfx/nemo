        "objectName": "viewerFrame_panel-16"
      },
      "property": "text"
    },
    {
      "kind": "key",
      "key": "A",
      "modifiers": "Ctrl"
    },
    {
      "kind": "key",
      "key": "5"
    },
    {
      "kind": "key",
      "key": "Return"
    },
    {
      "kind": "wait",
      "ms": 1800
    },
    {
      "kind": "read",
      "name": "A-after-B-seek",
      "target": {
        "panelType": "viewer",
        "group": "A"
      },
      "property": "panelContext"
    },
    {
      "kind": "read",
      "name": "A-frame-after-B-seek",
      "target": {
        "panelType": "viewer",
        "group": "A",
        "property": "controller"
