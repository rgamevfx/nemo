          "/tmp/nemo43-smoke/busy-19.png",
          "/tmp/nemo43-smoke/busy-20.png",
          "/tmp/nemo43-smoke/busy-21.png",
          "/tmp/nemo43-smoke/busy-22.png",
          "/tmp/nemo43-smoke/busy-23.png",
          "/tmp/nemo43-smoke/busy-24.png",
          "/tmp/nemo43-smoke/busy-25.png",
          "/tmp/nemo43-smoke/busy-26.png",
          "/tmp/nemo43-smoke/busy-27.png",
          "/tmp/nemo43-smoke/busy-28.png",
          "/tmp/nemo43-smoke/busy-29.png",
          "/tmp/nemo43-smoke/busy-30.png",
          "/tmp/nemo43-smoke/busy-31.png",
          "/tmp/nemo43-smoke/busy-32.png",
          "/tmp/nemo43-smoke/busy-33.png",
          "/tmp/nemo43-smoke/busy-34.png",
