{
    "version": 6,
    "include": ["CMakePresets.json"],
    "configurePresets": [
        {
            "name": "local-debug",
            "displayName": "Local Debug (adjust VCPKG_ROOT to your checkout)",
            "inherits": "debug",
            "environment": {
                "VCPKG_ROOT": "/home/YOU/.local/share/vcpkg"
            }
        }
    ],
    "buildPresets": [{ "name": "local-debug", "configurePreset": "local-debug" }],
    "testPresets": [{ "name": "local-debug", "configurePreset": "local-debug" }]
}
