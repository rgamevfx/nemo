      "method": "revealMediaPanel",
      "args": [
        "A"
      ]
    },
    {
      "kind": "waitForPanel",
      "panelType": "media",
      "group": "A",
      "timeoutMs": 20000
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-1"
      ]
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-3"
      ]
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-8"
      ]
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-6"
      ]
