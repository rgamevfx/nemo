{
  "phase": "final-busy",
  "group": "A",
  "panelType": "media",
  "settleMs": 500,
  "grabWindow": true,
  "quit": true,
  "lingerMs": 1200,
  "steps": [
    {
      "kind": "invoke",
      "target": "mediaLibrary",
      "method": "revealMediaPanel",
      "args": [
        "A"
      ]
    },
    {
      "kind": "waitForPanel",
      "panelType": "media",
      "group": "A",
      "timeoutMs": 20000
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-1"
      ]
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-3"
      ]
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-8"
      ]
    },
    {
      "kind": "invoke",
      "target": "workspace",
      "method": "closePanel",
      "args": [
        "panel-6"
      ]
    },
    {
      "kind": "resizeWindow",
      "width": 1274,
      "height": 640
    },
    {
      "kind": "setPanelState",
      "panelType": "media",
      "group": "A",
      "state": {
        "viewMode": "list",
        "projectScope": true
      }
    },
    {
      "kind": "wait",
      "ms": 400
    },
    {
      "kind": "invoke",
      "target": "mediaLibrary",
      "method": "importPaths",
      "args": [
        [
          "/tmp/nemo43-smoke/busy-00.png",
          "/tmp/nemo43-smoke/busy-01.png",
          "/tmp/nemo43-smoke/busy-02.png",
          "/tmp/nemo43-smoke/busy-03.png",
          "/tmp/nemo43-smoke/busy-04.png",
          "/tmp/nemo43-smoke/busy-05.png",
          "/tmp/nemo43-smoke/busy-06.png",
          "/tmp/nemo43-smoke/busy-07.png",
          "/tmp/nemo43-smoke/busy-08.png",
          "/tmp/nemo43-smoke/busy-09.png",
          "/tmp/nemo43-smoke/busy-10.png",
          "/tmp/nemo43-smoke/busy-11.png",
          "/tmp/nemo43-smoke/busy-12.png",
          "/tmp/nemo43-smoke/busy-13.png",
          "/tmp/nemo43-smoke/busy-14.png",
          "/tmp/nemo43-smoke/busy-15.png",
          "/tmp/nemo43-smoke/busy-16.png",
