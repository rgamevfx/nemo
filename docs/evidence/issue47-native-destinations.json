    "independent_destinations": {
      "destination_a": 2,
      "destination_b": 3,
      "output_a": "2",
      "output_b": "3",
      "note": "Panels A and B published different graph outputs (2 and 3) concurrently; each result carries its own destination tag (2/3) and no result crosses destinations."
    },
    "rapid_supersession": {
      "a_before": 12,
      "a_after_three_frames": 15,
      "a_local_time": 3,
      "b_request_unchanged": true,
      "note": "setFrame 1/2/3 on A published only A's newest frame (t=3); B's request id and frame were untouched."
    },
    "cache_replay": {
      "a_half": 2,
      "b_quarter": 4,
      "b_cache_hit_on_channel_republish": true,
      "note": "Changing B's proxy resolution to Quarter re-sampled without touching A's Half request; a channel republish of the same evaluation request returned cache_hit=true, so the destination-scoped cache path replayed instead of re-evaluating."
    },
    "current_outdated": {
      "a_outdated_while_frame_5_in_flight": true,
      "a_previous_presentation_kept": 4,
      "note": "The last valid frame stayed presented and marked outdated until the newer request arrived."
    },
    "transport_input": {
      "a_after_next_click": 4,
      "a_playing_toggled": "nextButton advanced A to frame 4; playButton toggled playback and was paused again",
      "b_request_stable_across_a_transport": true,
      "note": "B republished once when the harness restored RGBA after the channel leg; A's transport input did not touch B's request id (transport-B == narrow-B == pre-close-B)."
    },
    "panel_close": {
      "survivor_output": "3",
      "survivor_frame": 1,
      "capture": "viewer-closed.png / viewer-closed-b.png show the surviving panel B rendering its own target",
      "note": "Closing panel A through the workspace destroyed its panel and released destination 2; the surviving panel B kept rendering output 3 and published a new frame. The structural split rebuild re-creates the survivor's controller, so its destination id is re-allocated (closed-a-b destination 2) and its request identity restarts; the rendered target is preserved."
    }
  },
  "acceptance_examples": {
    "1_two_panels_independent": "Met natively: distinct destinations 2/3, distinct outputs 2/3, concurrent renders (records.jsonl initial*).",
    "2_per_destination_stale_rejection": "Met: A supersession left B's request id and frame untouched; A's in-flight frame left the previous presentation outdated.",
    "3_cached_replay_identity": "Met: channel republish of the same evaluation request reported cache_hit=true on B.",
    "4_retained_lifetimes": "ASan native run (native-asan-run.log) exits 0 with no ownership report for the two-destination scenario; the existing cancelled-submission retention tests remain unchanged.",
    "5_native_per_destination_record": "Met: records.jsonl reports destination id, request id, output, local time, region, sampling scale/resolution, cache hit, pending/outdated, render state and the Qt frameSwapped presentation boundary for both destinations.",
    "6_context_apis_explicit_unavailable": "Unchanged from the implementation evidence; role/group stay in PanelContextRouter.",
    "7_transport_and_geometry": "Met: transport input on A; wide 623px and narrow 386px (below the 560/530 breakpoints) captures show the compact transport and both destinations."
  },
  "limitations": [
    "Native Wayland/Qt 6.4.2 only; Windows not exercised.",
    "The split rebuild on a structural panel close re-creates the surviving panel's controller and re-allocates its destination; destination identity is not stable across that close. Whether the workspace should preserve peer controller identity across a structural close is #40/#59 presentation behavior, reported here rather than changed.",
    "The narrow capture uses the shell's minimum-width relaxation in the harness to reach 386px panels; the prototype reference is 380px.",
    "No issue:13 latency/scanout claim; the frame boundary reported is Qt's frameSwapped handoff.",
    "Depth layer and non-RGBA channel availability are still reported, not fabricated."
