# Baseline checks: correctness, performance, modernization. Tune per module as
# the codebase grows; do not add NOLINT without a reason in the same line.
Checks: >
    bugprone-*,
    misc-*,
    modernize-*,
    performance-*,
    readability-*,
    clang-analyzer-*,
    -modernize-use-trailing-return-type,
    -readability-magic-numbers,
    -readability-identifier-length,
    -bugprone-easily-swappable-parameters,
    -misc-include-cleaner

WarningsAsErrors: ''
HeaderFilterRegex: 'src/nemo/.*'
FormatStyle: file
