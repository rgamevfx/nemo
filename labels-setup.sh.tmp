#!/usr/bin/env bash
# Labels encode review gates and areas. Idempotent.
set -euo pipefail

mklabel() {
    gh label create "$1" --color "$2" --description "$3" --force >/dev/null 2>&1 || true
}

mklabel "area:core"        "1d76db" "Document/commands/evaluation"
mklabel "area:gpu"         "0e8a16" "Vulkan, Slang, GPU resources"
mklabel "area:ui"          "d93f0b" "Qt Quick panels, workspace, viewer"
mklabel "area:media"       "fbca04" "FFmpeg, OIIO, OCIO, OpenEXR"
mklabel "area:automation"  "5319e7" "CLI, Python, MCP adapters"
mklabel "area:build"       "cccccc" "CMake, vcpkg, CI"
mklabel "risk:api-change"  "b60205" "Public API change — explicit human review required"
mklabel "risk:deps"        "b60205" "Dependency addition/bump — explicit human review required"
mklabel "risk:baseline"    "b60205" "Image baseline change — explicit human review required"
mklabel "prototype-gate"   "5319e7" "Blocks the spec section 11 vertical slice"
mklabel "good-first-issue" "7057ff" "Small, well-isolated, safe first ticket"
