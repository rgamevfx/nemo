                id: graphSearchList
                objectName: "graphSearchList"
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                currentIndex: 0
                model: graphPanel.filteredCatalog("")
                delegate: ItemDelegate {
                    required property var modelData
                    width: graphSearchList.width
                    height: 29
